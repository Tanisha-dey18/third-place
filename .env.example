# ─────────────────────────────────────────────────────────────
# THIRD PLACE environment variables
# Copy to .env.local for local development. Never commit real values.
# Variables prefixed with VITE_ are bundled into the browser build
# and MUST be safe for public exposure.
# ─────────────────────────────────────────────────────────────

# ── Supabase (browser-safe) ───────────────────────────────────
# Project URL and the *anon/publishable* key. Row Level Security protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where café records come from: "demo" (bundled fictional sample data)
# or "supabase" (the cafes table in your database).
VITE_CAFE_DATA_SOURCE=demo

# ── Maps (browser-safe) ───────────────────────────────────────
# Leaflet tile template + attribution. Default: OpenStreetMap community tiles,
# which are for demos/light use only (https://operations.osmfoundation.org/policies/tiles/).
# For production use a keyed provider, e.g.
#   VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_PUBLIC_KEY
#   VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
# (Browser map keys are public by design: restrict them to your domain in the provider dashboard.)
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
# Set to "false" to disable the map entirely (list view still works).
VITE_MAP_ENABLED=true

# ── AI-assisted search (browser-safe flag only) ───────────────
# "true" makes the browser call the /.netlify/functions/ai-search function.
# The function itself needs the server-side variables below.
VITE_AI_SEARCH_ENABLED=false

# ── Server-side only (Netlify Functions). NEVER prefix with VITE_ ──
# Provider: "anthropic" | "gemini" | "groq"
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: comma-separated origins allowed to call the function.
AI_ALLOWED_ORIGINS=

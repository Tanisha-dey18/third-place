# ═════════════════════════════════════════════════════════════════
# THIRD PLACE environment variables
# Local: copy to .env.local (never commit it).
# Netlify: Site configuration → Environment variables.
#
# VITE_* variables are baked into the PUBLIC browser bundle at build
# time. Only ever put public values in them. Everything else is read
# by Netlify Functions on the server and never reaches browsers.
# `npm run check:env` (also run on every Netlify build) refuses
# secrets in VITE_* variables and demo mode in production.
# ═════════════════════════════════════════════════════════════════

# ── Supabase (browser-safe) ── accounts, saved places sync, reviews, reports
# Project URL and the anon / publishable key (NOT the service-role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Development demo mode (browser) ──
# "true" swaps live data for 18 FICTIONAL cafés. Local development only:
# production builds with this on are rejected by check-env.
VITE_DEMO_MODE=false

# ── Maps (browser-safe) ──
# Default: OpenStreetMap community tiles — demos/light use only
# (https://operations.osmfoundation.org/policies/tiles/). For production use a
# keyed provider and restrict the key to your domain, e.g.
#   VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_PUBLIC_KEY
#   VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_MAP_ENABLED=true

# ── AI-assisted search (browser flag only; optional) ──
VITE_AI_SEARCH_ENABLED=false

# ═════════════ Server-only (Netlify Functions) — never prefix with VITE_ ═════════════

# ── OpenStreetMap data (no key needed) ──
# Contact e-mail shown to OpenStreetMap service operators in the User-Agent. E-mail ONLY:
# overpass-api.de rejects User-Agents containing a site URL/hostname with HTTP 406.
OVERPASS_CONTACT=
# Optional comma-separated Overpass endpoints (https only), e.g. a paid or self-hosted instance.
# Default: https://overpass-api.de/api/interpreter,https://z.overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter
OVERPASS_URLS=

# ── CORS (optional) ── extra origins allowed to call /api/* cross-origin.
# The site's own URL (Netlify's URL / DEPLOY_PRIME_URL) is always allowed.
APP_ORIGIN=
AI_ALLOWED_ORIGINS=

# ── AI provider (optional; discovery works without it) ──
# AI_PROVIDER: anthropic | gemini | groq
AI_PROVIDER=
AI_MODEL=
# Max AI provider calls per UTC day across all users (default 500).
AI_DAILY_LIMIT=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Not used by this app — do NOT add SUPABASE_SERVICE_ROLE_KEY to the site.
